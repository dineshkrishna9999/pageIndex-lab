{
  "name": "vectorless-rag",
  "dockerFile": "Dockerfile",
  "customizations": {
    "vscode": {
      "settings": {
        "[python]": {
          "editor.tabSize": 4,
          "editor.insertSpaces": true,
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff",
          "testing.unittestEnabled": false,
          "testing.pytestEnabled": true,
          "testing.pytestArgs": ["tests"]
        },
        "[markdown]": {
          "editor.wordWrap": "on",
          "editor.quickSuggestions": {
            "other": "off",
            "comments": "off",
            "strings": "off"
          }
        },
        "[yaml]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true,
          "editor.formatOnSave": true
        },
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/__pycache__": true,
          "**/.mypy_cache": true,
          "**/site": true
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "terminal.integrated.fontFamily": "'Hack Nerd Font', Consolas, monospace",
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installOhMyZshConfig": false,
      "configureZshAsDefaultShell": true
    },
    "ghcr.io/jsburckhardt/devcontainer-features/uv:1": {}
  },
  "mounts": [
    "source=cogito-vault-zshhistory,target=/commandhistory,type=volume"
  ],
  "postCreateCommand": "bash scripts/post-create.sh"
}
